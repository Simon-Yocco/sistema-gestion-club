# Copiar a .env y completar.

# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos (usuario creado por db/init.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tienda
DB_PASSWORD=tienda_dev_pass
DB_NAME=tienda_dev
DB_NAME_TEST=tienda_test

# Autenticación: usar un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Zona horaria para mostrar fechas (en la base se guardan en UTC)
TZ_DISPLAY=America/Argentina/Buenos_Aires
